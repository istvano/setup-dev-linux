#!/usr/bin/env python3
"""Render capability matrix to stdout, or update its file with explicit --write."""
import argparse
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True
from catalogue_matrix import render_matrix

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--write', action='store_true')
args = parser.parse_args()
text = render_matrix(json.loads((root / 'catalogue/capabilities.json').read_text()))
if args.write:
    (root / 'docs/CAPABILITY-MATRIX.md').write_text(text)
else:
    print(text, end='')
