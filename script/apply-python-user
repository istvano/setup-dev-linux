#!/usr/bin/python3 -B
"""Internal Ansible worker for the pinned user uv and CPython."""
import json
import sys

sys.dont_write_bytecode = True
from workstation.python_user import install

try:
    request = json.load(sys.stdin)
    print(json.dumps({'changed': install(request['config'], request['selected'])}))
except Exception:
    print('User Python delivery failed; inspect reviewed inputs and private runtime state.',
          file=sys.stderr)
    raise SystemExit(1)
