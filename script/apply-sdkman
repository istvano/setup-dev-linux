#!/usr/bin/python3 -B
"""Internal Ansible SDKMAN manager worker."""
import json
import sys
sys.dont_write_bytecode = True
from workstation.sdkman_runtime import install
try:
    request = json.load(sys.stdin)
    print(json.dumps({'changed': install(request['config'])}))
except Exception:
    print('SDKMAN manager delivery failed; inspect reviewed inputs and private manager state.', file=sys.stderr)
    raise SystemExit(1)
