#!/usr/bin/python3 -B
"""Render the operator review document from inventory, curation and the Mac baseline.

Joins what this machine actually has against the proposed decisions, marks where
each item came from, and refuses to hide anything: an observed item with no
proposal is reported as a gap rather than silently omitted.
"""
import argparse
import json
import re
import subprocess
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SYMBOL = {'keep': '**keep**', 'drop': 'drop', 'defer': '**decide**'}


def mac_tokens(mac):
    """Profile membership of every active Brewfile token in the Mac checkout."""
    tokens = defaultdict(list)
    profiles = mac / 'profiles'
    if not profiles.is_dir():
        return tokens
    for path in sorted(profiles.glob('*.Brewfile')):
        for line in path.read_text().splitlines():
            match = re.match(r'\s*(?:brew|cask) "([^"]+)"', line)
            if match:
                tokens[match.group(1).split('/')[-1]].append(path.stem)
    return tokens


# Mac tokens whose Linux equivalent is named differently.
ALIASES = {
    'kubernetes-cli': 'kubectl', 'visual-studio-code': 'code',
    'dbeaver-community': 'dbeaver-ce', 'google-chrome': 'google-chrome-stable',
    'obs': 'obs-studio', 'git-delta': 'git-delta', 'awscli': 'awscli',
    'azure-cli': 'azure-cli', 'font-fira-code-nerd-font': 'font-firacode-nerd',
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inventory', type=Path, required=True)
    parser.add_argument('--mac-source', type=Path, required=True)
    parser.add_argument('--output', type=Path, default=ROOT / 'docs/INVENTORY-REVIEW.md')
    args = parser.parse_args()

    inventory = json.loads(args.inventory.read_text())
    curation = json.loads((ROOT / 'catalogue/curation.json').read_text())
    mac = mac_tokens(args.mac_source)

    proposals = {item['id']: item for item in curation['items']}
    groups = {g['id']: g for g in curation['groups']}
    order = [g['id'] for g in curation['groups']]

    # Everything this machine actually has, by curation id.
    observed = {}
    for package in inventory['apt']['manual']:
        observed[package['name']] = ('apt', package['version'], package['origin'])
    for snap in inventory['snaps']:
        if not snap['base_or_platform']:
            observed[snap['name']] = ('snap', snap['version'], snap['publisher'])
    for binary in inventory['unmanaged_binaries']:
        if binary['unmanaged']:
            path = binary['path'].replace(str(Path.home()), '~')
            observed[path] = ('binary', None, binary['directory'])

    rows = defaultdict(list)
    for item in curation['items']:
        here = item['id'] in observed
        token = item['id'].split('/')[-1]
        in_mac = bool(mac.get(token) or mac.get(item['id']))
        for alias, linux in ALIASES.items():
            if linux == item['id'] and alias in mac:
                in_mac = True
        if item['kind'] == 'mac-only':
            provenance, detail = 'mac', ', '.join(sorted(set(sum((mac.get(t, []) for t in (item['id'],)), [])))) or 'mac baseline'
        elif here and in_mac:
            provenance, detail = 'both', observed[item['id']][1] or ''
        elif here:
            provenance, detail = 'here', observed[item['id']][1] or ''
        elif in_mac:
            provenance, detail = 'mac', 'mac baseline'
        else:
            provenance, detail = 'new', 'not installed here'
        rows[item['group']].append((item, provenance, detail))

    missing = sorted(set(observed) - set(proposals))

    lines = [
        '# Inventory review',
        '',
        'Generated by `script/inventory-review` from `catalogue/curation.json`.',
        'Every item was reviewed with the operator; rows marked `decided` were',
        'confirmed rather than defaulted. Only `keep` items enter `manifest/`.',
        '',
        '| Provenance | Meaning |',
        '|---|---|',
        '| `here` | Installed on this workstation now |',
        '| `mac` | In the Mac baseline only; not installed here |',
        '| `both` | Installed here and declared in the Mac baseline |',
        '| `new` | Chosen in review; installed on neither machine yet |',
        '',
    ]

    counts = defaultdict(int)
    for item in curation['items']:
        counts[item['proposal']] += 1
    decided = sum(1 for i in curation['items'] if i.get('decided'))
    lines += [f"**{counts['keep']} keep**, {counts['drop']} drop across "
              f"{len(curation['items'])} items; {decided} confirmed in review"
              + (f", {counts['defer']} still open." if counts['defer'] else "."), '']

    for group in order:
        if not rows.get(group):
            continue
        info = groups[group]
        lines += [f"## {info['title']}", '', info['description'], '',
                  '| Item | Kind | From | Version / detail | Decision | Why |',
                  '|---|---|---|---|---|---|']
        for item, provenance, detail in sorted(
                rows[group], key=lambda r: ({'defer': 0, 'keep': 1, 'drop': 2}[r[0]['proposal']], r[0]['id'])):
            lines.append(f"| `{item['id']}` | {item['kind']} | {provenance} | {detail} | "
                         f"{SYMBOL[item['proposal']]} | {item['reason']} |")
        lines.append('')

    lines += ['## Coverage', '',
              f"Observed items on this machine: {len(observed)}. "
              f"Covered by a proposal: {len(observed) - len(missing)}.", '']
    if missing:
        lines += ['**Observed but unproposed — these need a decision before implementation:**', '']
        lines += [f'- `{name}` ({observed[name][0]})' for name in missing]
        lines.append('')
    else:
        lines += ['Every observed item has a proposal.', '']

    lines += ['## Not covered by this document', '',
              'GNOME settings, dotfiles and file migration are reviewed separately:',
              '',
              f"- **GNOME**: {len(inventory['desktop']['dconf'])} dconf sections changed from default, "
              f"{len(inventory['desktop']['gnome_extensions'])} shell extensions.",
              f"- **Dotfiles**: {len([d for d in inventory['dotfiles'] if not d['noise'] and not d['secret']])} "
              f"configuration entries, {len([d for d in inventory['dotfiles'] if d['secret']])} credential-bearing, "
              f"{len([d for d in inventory['dotfiles'] if d['noise']])} caches and histories to skip.",
              f"- **Home trees**: {', '.join(t['name'] for t in inventory['home_trees'])}.",
              '']

    args.output.write_text('\n'.join(lines))
    print(f'wrote {args.output} ({len(curation["items"])} items, {len(missing)} gaps)')
    return 1 if missing else 0


if __name__ == '__main__':
    raise SystemExit(main())
