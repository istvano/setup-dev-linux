#!/usr/bin/python3 -B
"""Record the signing-key fingerprint of every third-party APT source.

A key fetched over HTTPS is only as trustworthy as the transport unless the key
itself is pinned. This fetches each published key once, records its primary
fingerprint in the manifest, and the installer then refuses any key that does
not match. Re-running after a vendor rotates a key shows the change as a diff
rather than accepting it silently.
"""
import argparse
import json
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / 'manifest/repositories.json'


def fingerprint(data):
    """Primary key fingerprint of an armoured or binary keyring."""
    with tempfile.NamedTemporaryFile(suffix='.key') as handle:
        handle.write(data)
        handle.flush()
        output = subprocess.run(
            ['gpg', '--show-keys', '--with-colons', '--with-fingerprint', handle.name],
            capture_output=True, text=True, check=True).stdout
    for line in output.splitlines():
        if line.startswith('fpr:'):
            value = line.split(':')[9]
            if re.fullmatch(r'[0-9A-F]{40}', value):
                return value
    raise LookupError('no fingerprint in key material')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--write', action='store_true')
    args = parser.parse_args()

    manifest = json.loads(MANIFEST.read_text())
    changed, failures = [], []
    for repo in manifest['repositories']:
        try:
            if repo.get('key_file'):
                data = (ROOT / repo['key_file']).read_bytes()
            else:
                request = urllib.request.Request(
                    repo['key_url'], headers={'User-Agent': 'linux-os-setup'})
                with urllib.request.urlopen(request, timeout=60) as response:
                    data = response.read()
            observed = fingerprint(data)
        except (urllib.error.URLError, OSError, LookupError,
                subprocess.SubprocessError) as exc:
            failures.append(f"{repo['id']}: {exc}")
            print(f"FAIL {repo['id']}: {exc}", file=sys.stderr)
            continue

        recorded = repo.get('key_fingerprint')
        if recorded and recorded != observed:
            failures.append(f"{repo['id']}: recorded {recorded}, published {observed}")
            print(f"DRIFT {repo['id']}: recorded {recorded} but published {observed}",
                  file=sys.stderr)
            continue
        if not recorded:
            repo['key_fingerprint'] = observed
            changed.append(repo['id'])
        print(f"{repo['id']:26s} {observed}"
              + ('  (new)' if repo['id'] in changed else '  (unchanged)'))

    if args.write and changed:
        MANIFEST.write_text(json.dumps(manifest, indent=2) + '\n')
        print(f'\nrecorded {len(changed)} fingerprints', file=sys.stderr)
    if failures:
        print(f'\n{len(failures)} unresolved', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
