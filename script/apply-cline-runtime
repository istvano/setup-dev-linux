#!/usr/bin/python3 -B
"""Internal Ansible worker for the reviewed Cline CLI-only package closure."""
import json
import sys

sys.dont_write_bytecode = True
from workstation.cline_runtime import install

try:
    request = json.load(sys.stdin)
    print(json.dumps({'changed': install(request['config'], request['selected'])}))
except Exception:
    print('Cline delivery failed; inspect reviewed inputs and private runtime state.',
          file=sys.stderr)
    raise SystemExit(1)
