{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "manager", "toolchain"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256", "licence", "licence_files", "shims"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://static\\.rust-lang\\.org/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "licence": {"type": "string", "minLength": 1},
        "licence_files": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "shims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "host", "date", "manifest", "manifest_checksum", "components", "licence", "licence_files", "files"],
      "properties": {
        "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "host": {"const": "x86_64-unknown-linux-gnu"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "manifest": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "manifest_checksum": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "components": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "url", "sha256"],
            "properties": {
              "id": {"enum": ["cargo", "rust-std", "rustc"]},
              "url": {"type": "string", "pattern": "^https://static\\.rust-lang\\.org/dist/"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "licence": {"type": "string", "minLength": 1},
        "licence_files": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "executable"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "executable": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
