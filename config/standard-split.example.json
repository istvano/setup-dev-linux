{
  "schema_version": 1,
  "example_only": true,
  "target": {
    "os": "ubuntu",
    "release": "26.04",
    "architecture": "amd64",
    "user": "REPLACE_USER"
  },
  "selection_file": "../profiles/default.json",
  "features": {
    "gpu": "none"
  },
  "storage": {
    "mode": "standard",
    "layout": "split",
    "separate_var_lib": true,
    "encryption": "none",
    "disks": {
      "system": {
        "stable_id": "REPLACE_SYSTEM_STABLE_ID",
        "minimum_bytes": null
      },
      "data": {
        "stable_id": "REPLACE_DATA_STABLE_ID",
        "minimum_bytes": null
      }
    },
    "mounts": {
      "/boot/efi": {
        "disk_role": "system",
        "filesystem_uuid": "REPLACE_BOOT_EFI_UUID"
      },
      "/boot": {
        "disk_role": "system",
        "filesystem_uuid": "REPLACE_BOOT_UUID"
      },
      "/": {
        "disk_role": "system",
        "filesystem_uuid": "REPLACE_ROOT_UUID"
      },
      "/home": {
        "disk_role": "data",
        "filesystem_uuid": "REPLACE_HOME_UUID"
      },
      "/var/lib": {
        "disk_role": "data",
        "filesystem_uuid": "REPLACE_VAR_LIB_UUID"
      }
    }
  }
}
