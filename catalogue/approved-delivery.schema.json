{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "source_package",
          "licence",
          "copyright_url",
          "copyright_sha256",
          "allowed_suites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]*$"
          },
          "source_package": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "copyright_url": {
            "type": "string",
            "pattern": "^https://changelogs.ubuntu.com/"
          },
          "copyright_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "allowed_suites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "resolute",
                "resolute-updates",
                "resolute-security"
              ]
            }
          }
        }
      }
    }
  }
}
