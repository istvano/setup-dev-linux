{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_at",
    "status",
    "catalogue_revision",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "pre-build-evidence-not-install-authorization"
    },
    "catalogue_revision": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "status",
        "proposed_channel",
        "evidence",
        "artifacts",
        "licence_observations",
        "remaining"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "review-required"
        },
        "proposed_channel": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "sha256",
              "description"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "platform",
              "url",
              "digest",
              "verification"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128}|sha3-384:[0-9a-f]{96}|sha512-[A-Za-z0-9+/]{86}==)$"
              },
              "verification": {
                "enum": [
                  "published-only",
                  "cached-apt-metadata",
                  "downloaded-observed",
                  "downloaded-matched-published",
                  "missing-digest"
                ]
              }
            }
          }
        },
        "licence_observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remaining": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "apt_observation": {
          "type": "object"
        },
        "snap_observation": {
          "type": "object"
        },
        "python_requires": {
          "type": "string",
          "minLength": 1
        },
        "vendor_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "extension_manifest": {
          "type": "object"
        }
      }
    }
  }
}
